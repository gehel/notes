# Mealie backend settings, loaded into the mealie-env ConfigMap. Reference (match the
# version to the image tag in deployment.yaml):
# https://docs.mealie.io/documentation/getting-started/installation/backend-config/
# No secrets here: this file is committed. SMTP/OIDC credentials, if ever added, go in a
# Secret and the matching *_FILE variables.

# Public URL, used in links sent by mail and for the OIDC callback. Keep in sync with the
# host in ../ingress.yaml.
BASE_URL=https://mealie.ledcom.fr
TZ=Europe/Zurich

# Accounts are created by invitation from the admin, never by self sign-up.
ALLOW_SIGNUP=false

# Trust X-Forwarded-For/-Proto from any source. Safe only because networkpolicy.yaml lets
# nothing but Traefik reach the pod. Narrow it to the cluster's pod CIDR once known.
HOST_IP=*
