// Home network topology — see network.md for the tool choice and how to render.
//
//   dot -Tsvg network.dot -o network.svg
//
// Edge styles carry meaning:
//   solid   verified from device output (neighbour tables, link flags, dumps)
//   dashed  inferred, consistent with the evidence but not directly confirmed
//   dotted  planned, not yet cabled

digraph home {
  rankdir=TB;
  bgcolor="white";
  splines=polyline;
  nodesep=0.45;
  ranksep=0.55;
  node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=10
        color="#44403c" fontcolor="#1c1917" penwidth=1.2];
  edge [fontname="Helvetica" fontsize=8 color="#57534e" fontcolor="#57534e"];

  // ---------------------------------------------------------------- upstream
  internet [label="Internet\nSwisscom 10 Gbps subscription"
            shape=ellipse fillcolor="#e7e5e4"];
  box      [label="Swisscom Internet-Box\n10.1.1.1\ngigabit ports — caps the line\nreplacement ordered 2026-09-04"
            fillcolor="#fee2e2"];

  // ------------------------------------------------------------------ routers
  mt1 [label="mikrotik1 — RB2011UiAS-2HnD\n192.168.1.1  ·  edge router\nCAPsMAN manager (legacy /caps-man)\nWAN ether1 = 10.1.1.101 (DHCP)\nNAT44 + NAT66\nether10 has PoE-out — but it is a bridge-fon port"
       fillcolor="#dbeafe"];
  mt2 [label="mikrotik2 — CRS125-24G-1S-2HnD\n192.168.1.2  ·  L2 bridge\n24×GE + SFP, hardware switch chip"
       fillcolor="#dbeafe"];
  mt3 [label="mikrotik3 — RB750Gr3 (hEX)\n192.168.1.3  ·  L2 bridge, office\n5×GE, no PoE-out"
       fillcolor="#dbeafe"];

  rb5009 [label="RB5009UG+S+IN\nplanned — future edge router\nfixes IPv6 (no NAT66), runs QoS\nhosts both CAPsMAN managers (B3)"
          fillcolor="#f5f5f4" style="rounded,filled,dashed"];
  poesw  [label="Office PoE switch\nplanned — 8×GE with PoE-out\nmust do PASSIVE PoE (SXTsq needs it)\nand must not energise non-PoE ports"
          fillcolor="#f5f5f4" style="rounded,filled,dashed"];

  // ----------------------------------------------------------------- wireless
  subgraph cluster_wifi {
    label="Wireless — SSID LEDCOM, WPA2-PSK";
    fontname="Helvetica"; fontsize=10; fontcolor="#57534e";
    style="rounded,dashed"; color="#a8a29e";

    cap6 [label="cap6 — mikrotik1 wlan1\n2.4 GHz  ch 1  (2412/20)\nAtheros AR9300" fillcolor="#dcfce7"];
    cap7 [label="cap7 — mikrotik2 wlan1\n2.4 GHz  ch 11 (2462/20)\nAtheros AR9300" fillcolor="#dcfce7"];
    capx [label="cAP XL ac\nplanned — 2.4 GHz + 5 GHz\nthe only 5 GHz on the network\nCEILING mount, central"
          fillcolor="#f5f5f4" style="rounded,filled,dashed"];
    mt4  [label="mikrotik4 — SXTsq Lite2\n192.168.1.4  ·  planned\n2.4 GHz ch 6, DIRECTIONAL\naimed at the garden"
          fillcolor="#f5f5f4" style="rounded,filled,dashed"];
  }

  inj [label="PoE injectors ×2\npassive — required because\nmikrotik3 has no PoE-out"
       shape=note fillcolor="#fef3c7" style="filled,dashed"];

  // -------------------------------------------------------------------- hosts
  desktop [label="desktop\n192.168.1.90  ·  wired\nin mgmt list" fillcolor="#ede9fe"];
  laptops [label="2 laptops\noccasional, wired\nplanned" fillcolor="#f5f5f4" style="rounded,filled,dashed"];
  pihole  [label="Pi-hole\n192.168.1.40  ·  DNS" fillcolor="#ede9fe"];
  ha      [label="Home Assistant\n192.168.1.60\nAPI user 'homeassistant'" fillcolor="#ede9fe"];
  iot     [label="IoT — flat segment today\nTasmota, ESPHome, OctoPrint,\nHombli fan\nto be isolated in a VLAN\nwith NO internet access" fillcolor="#fed7aa"];
  tv      [label="TV\nwireless client on LEDCOM\nto be moved to wired\n(Swisscom TV box retired)" fillcolor="#ede9fe"];
  fonera  [label="Fonera\n192.168.1.101 on mikrotik1 ether3\nTO BE REMOVED" fillcolor="#fee2e2" style="rounded,filled,dashed"];
  fon     [label="bridge-fon — 192.168.2.0/24\nether6-10, NO LINK on any port\npool .100-.200 idle\nether10 is here, and has the PoE-out" fillcolor="#fef3c7" style="rounded,filled,dashed"];

  // -------------------------------------------------------------------- links
  internet -> box   [label="  10 Gbps sold\n  ~940 Mbps real"];
  box -> mt1        [label="  ether1\n  10.1.1.0/24"];

  mt1 -> mt2        [label="  ether2-master\n  verified via neighbour table"];
  mt2 -> mt3        [label="  ether16 -> ether1\n  verified"];

  mt1 -> cap6       [style=bold color="#16a34a" label="  CAPsMAN"];
  mt2 -> cap7       [style=bold color="#16a34a" label="  CAPsMAN"];

  mt3 -> desktop    [label="  ether3", style=dashed];
  mt3 -> laptops    [style=dotted];
  mt3 -> inj        [style=dotted];
  inj -> capx       [style=dotted label="  passive PoE"];
  inj -> mt4        [style=dotted label="  passive PoE"];

  mt1 -> fonera     [label="  ether3 - verified", style=solid];
  mt1 -> fon        [label="  ether6-10", style=dashed];
  mt2 -> pihole     [label="  ether23 - verified"];
  mt2 -> ha         [label="  ether21 - verified"];
  mt2 -> iot        [style=dashed label="  wireless via cap6/cap7"];
  mt2 -> tv         [style=dashed label="  wireless"];

  rb5009 -> box     [style=dotted label="  replaces mikrotik1\n  at the edge"];
  poesw -> mt3      [style=dotted label="  replaces mikrotik3\n  removes the injectors"];

  { rank=same; desktop; laptops; }
}
