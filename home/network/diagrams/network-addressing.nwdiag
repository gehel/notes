// Address plan - which device sits on which VLAN.
// Physical cabling is a different picture: see network.dot / network.svg.
//
//   ./render-nwdiag.py -T svg network-addressing.nwdiag -o network-addressing.svg
//
// router is the gateway on every network (it holds an address on each);
// the switches and ap-main are pure L2 and appear once, on vlan-users only.
//
// ASCII only: the bundled font drops typographic dashes and middle dots.

nwdiag {
  default_fontsize = 10;
  node_width = 150;
  node_height = 72;

  network vlan-users {
    address = "192.168.10.0/24";
    label = "vlan 10 - vlan-users\nhome.ledcom.fr\ngw .1  DNS .40 (Pi-hole)\nunrestricted internet";

    group infra {
      label = "MikroTik: static, in mgmt";
      color = "#dbeafe";

      router            [address = ".1", label = "router\nRB5009\nedge + CAPsMAN mgr"];
      switch-main       [address = ".2", label = "switch-main\nCRS125\nL2 + CAPsMAN CAP ch11"];
      switch-office     [address = ".3", label = "switch-office\nRB750Gr3\nL2 office"];
      ap-main           [address = ".4", label = "ap-main\ncAP XL ac\nstandalone, LEDCOM"];
      switch-livingroom [address = ".5", label = "switch-livingroom\nRB750Gr3\nL2 living room"];
    }

    group clients {
      label = "Clients";
      color = "#dcfce7";

      desktop [address = ".90", label = "desktop \"during\"\nwired, in mgmt"];
      x1      [address = ".92", label = "laptop \"x1\"\nwireless, in mgmt"];
      tv      [address = ".50 .51", label = "Samsung TV\nwired + wifi"];
      amp     [address = ".52 .53", label = "Onkyo amp\nwired + wifi"];
      nintendo [address = ".54 .55", label = "Nintendo Switch\nwired + wifi"];
      printer [address = ".110", label = "Printer\nwired, reverted\nfrom services"];
      other   [address = "pool", label = "phones, others\nwireless"];
    }
  }

  network vlan-services {
    address = "192.168.20.0/24";
    label = "vlan 20 - vlan-services\ngw .1\nHTTPS + named exceptions";

    router [address = ".1"];

    group services {
      label = "Services";
      color = "#ede9fe";

      pihole [address = ".40", label = "Pi-hole\nDNS for the LAN"];
      hass   [address = ".60", label = "Home Assistant\nuser homeassistant"];
    }
  }

  network vlan-iot {
    address = "192.168.30.0/24";
    label = "vlan 30 - vlan-iot\ngw .1\nNO internet by default -\nnamed exceptions only";

    router [address = ".1"];

    group iotdev {
      label = "IoT devices";
      color = "#fed7aa";

      motioneye [address = ".20", label = "MotionEye\ngarage camera\nHTTP/HTTPS exception"];
      iotawatt  [address = ".50", label = "IotaWatt\nfirmware + NTP\nexception"];
      kidslight [address = ".61", label = "Kids light\nTasmota"];
      fan       [address = ".63", label = "Ceiling fan\nHombli\nDNS dropped by design"];
      octoprint [address = ".80 .81", label = "OctoPrint\nwired + wifi\nupdates exception"];
    }
  }

  network wireguard {
    address = "192.168.50.0/24";
    label = "wireguard1\nroad-warrior VPN\nusers policy, mgmt-only to users";

    router [address = ".1"];

    phone [address = ".2", label = "phone\nMrG Galaxy S24\nin mgmt"];
    x1-vpn [address = ".3", label = "laptop \"x1\"\nvia vpn.ledcom.fr\nin mgmt"];
  }
}
