// Home network topology — see ../network.md for the tool choice and how to render.
//
//   dot -Tsvg network.dot -o network.svg
//
// Edge styles carry meaning:
//   solid   verified from device output (neighbour tables, link flags, dumps)
//   dashed  inferred, or wireless (no cable to verify)
//   dotted  planned, not yet cabled/deployed, or kept only as a fallback

digraph home {
  rankdir=TB;
  bgcolor="white";
  splines=polyline;
  nodesep=0.45;
  ranksep=0.55;
  node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=10
        color="#44403c" fontcolor="#1c1917" penwidth=1.2];
  edge [fontname="Helvetica" fontsize=8 color="#57534e" fontcolor="#57534e"];

  // ---------------------------------------------------------------- upstream
  internet [label="Internet\nSwisscom 10 Gbps subscription"
            shape=ellipse fillcolor="#e7e5e4"];
  box      [label="Swisscom Internet-Box\n192.168.1.1  ·  no bridge mode\nDMZ host -> router (192.168.1.103)\nNAT44 here too (double NAT)"
            fillcolor="#e7e5e4"];

  // ---------------------------------------------------------- infrastructure
  router [label="router — RB5009UPr+S+IN\n192.168.10.1  ·  edge router since 2026-10-20\nWAN ether1 192.168.1.103 (DHCP, reserved)\nNAT44 + NAT66, firewall, DHCP, NTP\nCAPsMAN manager (legacy /caps-man)\nWireGuard 192.168.50.1"
          fillcolor="#dbeafe"];
  swmain [label="switch-main — CRS125-24G-1S-2HnD\n192.168.10.2  ·  L2 bridge, VLAN trunks\nCAPsMAN CAP (wlan1)\n24×GE + SFP"
          fillcolor="#dbeafe"];
  swoffice [label="switch-office — RB750Gr3 (hEX)\n192.168.10.3  ·  L2 bridge, office\n5×GE, no PoE-out"
            fillcolor="#dbeafe"];
  swliving [label="switch-livingroom — RB750Gr3 (hEX)\n192.168.10.5  ·  L2 bridge, living room\n5×GE"
            fillcolor="#dbeafe"];

  rb2011 [label="RB2011UiAS-2HnD (old mikrotik1)\noff the LAN since 2026-10-20\nstill on the box, rollback until ~2026-10-27\nthen wiped and redeployed"
          fillcolor="#f5f5f4" style="rounded,filled,dashed"];

  // ----------------------------------------------------------------- wireless
  subgraph cluster_wifi {
    label="Wireless — WPA2-PSK\nLEDCOM -> vlan-users (10), LEDCOM-IoT -> vlan-iot (30)";
    fontname="Helvetica"; fontsize=10; fontcolor="#57534e";
    style="rounded,dashed"; color="#a8a29e";

    capmain [label="switch-main wlan1 (CAPsMAN)\n2.4 GHz  ch 11 (2462/20)\nLEDCOM + LEDCOM-IoT" fillcolor="#dcfce7"];
    apmain  [label="ap-main — cAP XL ac\n192.168.10.4  ·  standalone wifi-qcom-ac\n2.4 + 5 GHz, LEDCOM only\n(no VLAN multi-SSID on this driver)" fillcolor="#dcfce7"];
    sxt     [label="SXTsq Lite2 (garden AP)\nplanned, not built, no name yet\n2.4 GHz, directional"
             fillcolor="#f5f5f4" style="rounded,filled,dashed"];
  }

  inj [label="PoE injector\npassive — switch-office has no PoE-out"
       shape=note fillcolor="#fef3c7" style="filled,dashed"];

  // ---------------------------------------------------------- vlan-users (10)
  desktop [label="desktop \"during\"\n192.168.10.90  ·  wired, mgmt list" fillcolor="#dcfce7"];
  printer [label="Printer NPI52346B\n192.168.10.110  ·  wired\nusers, reverted from services\n(mDNS repeater defect, see vlan.md)" fillcolor="#dcfce7"];
  tv      [label="Samsung TV\n192.168.10.50 wired  ·  .51 wifi" fillcolor="#dcfce7"];
  users_wifi [label="users wireless clients\nlaptop \"gimli\" (.92), phones,\nNintendo Switch, Onkyo amp, others\n(DHCP lease review pending)" fillcolor="#dcfce7" style="rounded,filled,dashed"];

  // ------------------------------------------------------- vlan-services (20)
  pihole  [label="Pi-hole\n192.168.20.40  ·  wired\nDNS for the whole LAN" fillcolor="#ede9fe"];
  ha      [label="Home Assistant\n192.168.20.60  ·  wired\nAPI user 'homeassistant'" fillcolor="#ede9fe"];

  // ------------------------------------------------------------- vlan-iot (30)
  octoprint [label="OctoPrint\n192.168.30.80 wired  ·  .81 wifi\nnamed internet exception (updates)" fillcolor="#fed7aa"];
  iotawatt  [label="IotaWatt\n192.168.30.50  ·  wireless" fillcolor="#fed7aa"];
  kidslight [label="Kids light (Tasmota)\n192.168.30.61  ·  wireless" fillcolor="#fed7aa"];
  fan       [label="Hombli ceiling fan\n192.168.30.63  ·  wireless\nDNS dropped by design" fillcolor="#fed7aa"];

  // -------------------------------------------------------------------- links
  internet -> box     [label="  10 Gbps sold\n  865 down / 858 up measured"];
  box -> router       [label="  router ether1 (2.5G)\n  192.168.1.0/24"];
  box -> rb2011       [style=dotted label="  ether1, fallback only"];

  router -> swmain    [label="  ether2 -> ether1, trunk\n  untagged 10, tagged 20/30\n  verified", style=solid];
  router -> apmain    [label="  ether3 -> ether1\n  1 Gbps, PoE, VLAN 10\n  verified", style=solid];
  swmain -> swoffice  [label="  ether16 -> ether1, trunk\n  verified", style=solid];
  swmain -> swliving  [label="  ether12 -> ether1, trunk\n  verified", style=solid];

  router -> capmain   [style=bold color="#16a34a" label="  CAPsMAN"];
  swmain -> capmain   [style=solid arrowhead=none];

  swoffice -> desktop [label="  ether3", style=dashed];
  swoffice -> printer [label="  ether2", style=solid];
  swoffice -> inj     [style=dotted];
  inj -> sxt          [style=dotted label="  passive PoE"];
  swliving -> tv      [label="  ether2", style=solid];

  swmain -> pihole    [label="  ether23, VLAN 20\n  verified", style=solid];
  swmain -> ha        [label="  ether21, VLAN 20\n  verified", style=solid];
  swmain -> octoprint [label="  ether24, VLAN 30\n  verified", style=solid];

  { capmain; apmain; } -> users_wifi [style=dashed];
  capmain -> octoprint [style=dashed label="  LEDCOM-IoT"];
  capmain -> iotawatt  [style=dashed];
  capmain -> kidslight [style=dashed];
  capmain -> fan       [style=dashed];

  { rank=same; router; rb2011; }
  { rank=same; desktop; printer; tv; users_wifi; }
  { rank=same; pihole; ha; }
  { rank=same; octoprint; iotawatt; kidslight; fan; }
}
